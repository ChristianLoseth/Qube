<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="qube" params="prefix">

    <!-- Parametre -->
    <xacro:property name="base_size" value="0.5"/>
    <xacro:property name="disk_radius" value="0.15"/>
    <xacro:property name="disk_height" value="0.05"/>
    <xacro:property name="indicator_length" value="0.2"/>
    <xacro:property name="indicator_thickness" value="0.01"/>
    <xacro:property name="leg_height" value="0.05"/>
    <xacro:property name="leg_radius" value="0.02"/>

    <!-- Base link -->
    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <box size="${base_size} ${base_size} ${base_size}"/>
        </geometry>
        <origin xyz="0 0 ${base_size/2 + leg_height}" rpy="0 0 0"/>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
    </link>

    <!-- Disk -->
    <link name="${prefix}disk_link">
      <visual>
        <geometry>
          <cylinder length="${disk_height}" radius="${disk_radius}"/>
        </geometry>
        <origin xyz="0 0 ${disk_height/2}" rpy="0 0 0"/>
        <material name="red">
          <color rgba="1 0 0 1"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}motor_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}disk_link"/>
      <origin xyz="0 0 ${base_size + leg_height}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="1.0" velocity="1.0"/>
    </joint>

    <!-- Indikator (viser) -->
    <link name="${prefix}indicator_link">
      <visual>
        <geometry>
          <box size="${indicator_length} ${indicator_thickness} ${indicator_thickness}"/>
        </geometry>
        <origin xyz="${indicator_length/2} 0 ${disk_height/2}" rpy="0 0 0"/>
        <material name="white">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
    </link>

    <joint name="${prefix}indicator_joint" type="fixed">
      <parent link="${prefix}disk_link"/>
      <child link="${prefix}indicator_link"/>
      <origin xyz="0 0 ${disk_height/2}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>

